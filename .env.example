# ==================== 密钥(必填,复制本文件为 .env 后填写) ====================

# MySekai 存档加密密钥(AES-128-CBC,各 16 字节,来自游戏客户端)
AES_KEY=your-16-byte-aes-key
AES_IV=your-16-byte-aes-iv

# Telegram Bot Token 与接收通知的 Chat ID(https://t.me/BotFather 创建)
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-bot-token
TELEGRAM_CHAT_ID=123456789

# ==================== 通知渠道(可选) ====================

# 推送时附带的图标 URL
BARK_ICON=

# 地图图片的公开访问根路径(server.py 会把 /archive/by-id/<user>/<时间戳> 拼在其后,
# 例如 https://your-cdn.example.com)
BARK_IMAGE_BASE=

# 没有 BARK_IMAGE_BASE 时,notify.py 生成图片 URL 所用的基础地址
FALLBACK_IMAGE_BASE=

# ==================== 路径覆盖(可选) ====================
# 默认分别为项目根下的 assets/、config/、data/,一般无需修改
# MYSK_ASSETS_DIR=
# MYSK_CONFIG_DIR=
# MYSK_DATA_DIR=

# ==================== Reqable 上报服务器 ====================
# 默认开启:服务端提供 POST /reqable/report 端点,接收 Reqable「上报服务器」
# 功能按 HAR 格式上报的会话(支持 gzip / brotli / zstd 压缩),与分片上传共存。
# 设 0 / false 可关闭该端点。
# REPORT_ENABLED=0

# 上报端点路径(Reqable 配置里填 服务地址 + 此路径)
# REPORT_PATH=/reqable/report

# HAR 请求体大小上限(MB,默认 1,与分片上传上限一致)
# REPORT_MAX_SIZE=1

# 可选共享令牌:设置后端点要求请求头 X-Report-Token 匹配。
# 注意 Reqable 无法附加自定义请求头,若用它上报,建议把随机串拼进
# REPORT_PATH(如 /reqable/report/3f9a...),或依靠反向代理 IP 白名单防护。
# REPORT_TOKEN=

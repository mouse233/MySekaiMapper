# ==================== 密钥(必填,复制本文件为 .env 后填写) ====================

# MySekai 存档加密密钥(AES-128-CBC,各 16 字节,来自游戏客户端)
AES_KEY=your-16-byte-aes-key
AES_IV=your-16-byte-aes-iv

# Telegram Bot Token 与接收通知的 Chat ID(https://t.me/BotFather 创建)
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-bot-token
TELEGRAM_CHAT_ID=123456789

# ==================== 通知渠道(可选) ====================

# 推送时附带的图标 URL
BARK_ICON=

# 地图图片的公开访问根路径(server.py 会把 /archive/by-id/<user>/<时间戳> 拼在其后,
# 例如 https://your-cdn.example.com)
BARK_IMAGE_BASE=

# 没有 BARK_IMAGE_BASE 时,notify.py 生成图片 URL 所用的基础地址
FALLBACK_IMAGE_BASE=

# ==================== 路径覆盖(可选) ====================
# 默认分别为项目根下的 assets/、config/、data/,一般无需修改
# MYSK_ASSETS_DIR=
# MYSK_CONFIG_DIR=
# MYSK_DATA_DIR=
